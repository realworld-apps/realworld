meta {
  name: List with limit=1&offset=1 (second page, so slug1)
  type: http
  seq: 5
}

get {
  url: {{host}}/api/articles?author=page_{{uid}}&limit=1&offset=1
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

script:post-response {
  expect(res.body.articles.length).to.eql(1);
  expect(res.body.articlesCount).to.eql(2);
  expect(res.body.articles[0].slug).to.eql(bru.getVar("slug1"));
  expect(Object.keys(res.body).length).to.eql(2);
  expect(Object.keys(res.body.articles[0]).length).to.eql(9);
  expect(Object.keys(res.body.articles[0].author).length).to.eql(4);
}
