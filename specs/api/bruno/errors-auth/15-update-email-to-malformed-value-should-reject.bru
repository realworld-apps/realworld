meta {
  name: Update email to malformed value - should reject
  type: http
  seq: 15
}

put {
  url: {{host}}/api/user
  body: json
  auth: none
}

headers {
  Authorization: Token {{token}}
}

body:json {
  {
    "user": {
      "email": "not-an-email"
    }
  }
}

assert {
  res.status: eq 422
}

script:post-response {
  expect(res.body.errors.email[0]).to.eql("is invalid");
}
