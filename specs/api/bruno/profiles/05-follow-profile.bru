meta {
  name: Follow profile
  type: http
  seq: 5
}

post {
  url: {{host}}/api/profiles/celeb_{{uid}}/follow
  body: none
  auth: none
}

headers {
  Authorization: Token {{token}}
}

assert {
  res.status: eq 200
}

script:post-response {
  expect(res.body.profile.username).to.eql("celeb_" + bru.getVar("uid"));
  expect(res.body.profile.bio).to.be.null;
  expect(res.body.profile.image).to.be.null;
  expect(res.body.profile.following).to.eql(true);
  expect(Object.keys(res.body).length).to.eql(1);
  expect(Object.keys(res.body.profile).length).to.eql(4);
}
