meta {
  name: Verify image empty string normalization persisted
  type: http
  seq: 15
}

get {
  url: {{host}}/api/user
  body: none
  auth: none
}

headers {
  Authorization: Token {{token}}
}

assert {
  res.status: eq 200
}

script:post-response {
  expect(res.body.user.image).to.be.null;
  expect(Object.keys(res.body).length).to.eql(1);
  expect(Object.keys(res.body.user).length).to.eql(5);
}
